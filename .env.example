# MongoDB Atlas connection string. Server-only; never use NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=courant

# Required: generate a unique random value of 32+ characters. Never commit real secrets.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: invitation code required for self-service teacher registration.
COURANT_TEACHER_INVITE_CODE=

# AI API keys are server-only and must never use NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Live conversational voice/video calls (Realtime API)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=marin

# Password recovery email via Resend. Required to enable password reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Courant <accounts@example.com>
APP_URL=http://localhost:3000
