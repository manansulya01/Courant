# Get this from MongoDB Atlas > Database > Connect > Drivers.
# Keep this value server-side; never prefix it with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=courant

# Add your AI provider key here later; do not expose it to the browser.
# AI_API_KEY=
