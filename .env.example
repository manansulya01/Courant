# Supabase project URL and publishable key (safe for browser use; RLS protects all exposed tables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini API keys are server-only and must never use NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Optional password recovery sender; Supabase Auth handles tokens and password updates.
# Configure a custom SMTP provider in the Supabase Auth settings for production delivery.

# Optional real-time animated AI teacher video (LiveAvatar).
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_CONTEXT_ID=
